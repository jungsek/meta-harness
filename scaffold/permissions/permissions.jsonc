{
  // Everything about what agents are allowed to do lives here — portable
  // declarations plus the native knobs that mean the same thing.
  //
  //   allow  never prompts
  //   deny   refused outright
  //   ask    prompts for approval
  //
  // Claude gets a `permissions` block in .claude/settings.json.
  // Codex gets Starlark prefix_rules in .codex/rules/meta-harness.rules —
  // its only per-command enforcement.
  //
  // A rule persuades; a permission enforces. For anything that genuinely
  // matters, write both — a rule in rules/ AND an entry here.
  "permission": {
    // Shell commands, matched as command prefixes.
    "bash": {
      "git status": "allow",
      "git diff": "allow",
      "rm -rf *": "deny"
      // "*": "ask"        // uncomment to prompt for everything else
    },

    // File writes (Claude only — Codex exec policy is command-scoped).
    "edit": {
      // "src/**": "allow"
    },

    // File reads. Keep secrets denied.
    "read": {
      ".env": "deny",
      ".env.*": "deny"
    }
  },

  // Native knobs with no portable equivalent. They belong here, with the
  // permissions they modify, rather than adrift in settings/.
  "codex": {
    // "approval_policy": "on-request",
    // "sandbox_mode": "workspace-write"
  },
  "claude": {
    // "defaultMode": "acceptEdits"
  }
}
