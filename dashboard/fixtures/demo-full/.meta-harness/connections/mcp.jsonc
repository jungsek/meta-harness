{
  // Stripe MCP for reading webhook logs and test-mode charges
  "mcpServers": {
    "stripe": {
      "command": "npx",
      "args": ["-y", "@stripe/mcp-server"],
      "env": { "STRIPE_API_KEY": "${STRIPE_API_KEY}" }
    },
    "postgres": {
      "url": "https://mcp.postgres.internal/orbit"
    }
  }
}
